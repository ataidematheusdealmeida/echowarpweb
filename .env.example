ECHOWARP_SERVER=
ECHOWARP_PORT=4415
ECHOWARP_PASSWORD=

WEB_PORT=3008
WEB_HOST=
WEB_AUTH_USER=admin@example.com
WEB_AUTH_PASSWORD=CHANGE_ME_BEFORE_START
WEB_SESSION_TTL_SECONDS=43200

# The PulseAudio playback device created inside the container.
ECHOWARP_DEVICE_NAME=EchoWarpWeb
ECHOWARP_LOG_LEVEL=info
ECHOWARP_EXTRA_ARGS=
ECHOWARP_MAX_RECONNECT=5
ECHOWARP_CLIENT_AUTO_RECONNECT=false
ECHOWARP_CLIENT_AUTO_RECONNECT_ATTEMPTS=0
ECHOWARP_SERVER_NAME=EchoWarpWeb
ECHOWARP_SERVER_DISCOVERY=true
ECHOWARP_MAX_CLIENTS=1
ECHOWARP_AUDIO_BUFFER_FRAMES=5
ECHOWARP_RATE_LIMIT=5
ECHOWARP_MAX_AUTH_FAILURES=5
ECHOWARP_RECORD=
ECHOWARP_RECORD_DIR=
ECHOWARP_TLS_CERT=
ECHOWARP_TLS_KEY=
ECHOWARP_BAN_FILE=
ECHOWARP_HWID_REQUIRED=false
ECHOWARP_SERVER_MUTED=false
HLS_TIME=0.5
HLS_LIST_SIZE=30
AUDIO_BITRATE=128k
RECORDING_RETENTION_HOURS=168
AUDIO_FILTER=dynaudnorm=f=75:g=3:p=0.95
SILENCE_RESTART_SECONDS=45
SILENCE_RESTART_COOLDOWN_SECONDS=120
SILENCE_DBFS_THRESHOLD=-88
SILENCE_PEAK_THRESHOLD=0.0005
